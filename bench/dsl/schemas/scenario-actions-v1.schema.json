{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenario-actions/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario_id", "track", "name", "initial_fixture", "steps"],
  "properties": {
    "schema_version": {"const": "scenario-actions/v1"},
    "scenario_id": {"type": "string"},
    "track": {"type": "string"},
    "name": {"type": "string", "minLength": 1},
    "initial_fixture": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/invoke"},
          {"$ref": "#/$defs/mutate"},
          {"$ref": "#/$defs/advanceTime"},
          {"$ref": "#/$defs/lifecycle"},
          {"$ref": "#/$defs/newSession"},
          {"$ref": "#/$defs/invokeWhileLocked"},
          {"$ref": "#/$defs/externalCrash"},
          {"$ref": "#/$defs/snapshotState"},
          {"$ref": "#/$defs/snapshotIndex"}
        ]
      }
    }
  },
  "$defs": {
    "invoke": {
      "type": "object", "additionalProperties": false,
      "required": ["step", "action", "operation", "params"],
      "properties": {"step": {"type": "integer", "minimum": 1}, "action": {"const": "invoke"}, "capture_id": {"type": "string"}, "operation": {"type": "string"}, "params": {"type": "object"}, "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 600000}}
    },
    "mutate": {
      "type": "object", "additionalProperties": false,
      "required": ["step", "action", "type", "target"],
      "properties": {
        "step": {"type": "integer", "minimum": 1}, "action": {"const": "mutate"},
        "type": {"enum": ["external_update", "semantic_change", "raw_invalidation", "create_version", "duplicate_version", "delete_file", "tamper_file", "create_file", "delete_tree", "touch_file", "corrupt_index", "semantic_tamper", "runtime_deviation"]},
        "target": {"type": "string"}, "content_hash": {"type": ["string", "null"]}, "content": {"type": "string"}, "reason": {"type": "string"},
        "new_ref": {"type": "string"}, "entity_id": {"type": "string"}, "version_ref": {"type": "string"}, "path": {"type": "string"}, "properties": {"type": "object"}
      }
    },
    "advanceTime": {"type": "object", "additionalProperties": false, "required": ["step", "action", "new_timestamp"], "properties": {"step": {"type": "integer", "minimum": 1}, "action": {"const": "advance_time"}, "new_timestamp": {"type": "string"}}},
    "lifecycle": {"type": "object", "additionalProperties": false, "required": ["step", "action"], "properties": {"step": {"type": "integer", "minimum": 1}, "action": {"enum": ["context_reset", "restart_sut"]}}},
    "newSession": {"type": "object", "additionalProperties": false, "required": ["step", "action", "session_id"], "properties": {"step": {"type": "integer", "minimum": 1}, "action": {"const": "new_session"}, "session_id": {"type": "string"}}},
    "invokeWhileLocked": {"type": "object", "additionalProperties": false, "required": ["step", "action", "capture_id", "operation", "params", "lock_path"], "properties": {"step": {"type": "integer", "minimum": 1}, "action": {"const": "invoke_while_locked"}, "capture_id": {"type": "string"}, "operation": {"type": "string"}, "params": {"type": "object"}, "lock_path": {"type": "string"}, "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 600000}}},
    "externalCrash": {"type": "object", "additionalProperties": false, "required": ["step", "action", "capture_id", "operation", "params", "pause_at"], "properties": {"step": {"type": "integer", "minimum": 1}, "action": {"const": "external_crash"}, "capture_id": {"type": "string"}, "operation": {"type": "string"}, "params": {"type": "object"}, "pause_at": {"type": "string"}, "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 600000}}},
    "snapshotState": {"type": "object", "additionalProperties": false, "required": ["step", "action", "capture_id"], "properties": {"step": {"type": "integer", "minimum": 1}, "action": {"const": "snapshot_state"}, "capture_id": {"type": "string"}, "require_no_tx_residue": {"type": "boolean"}}},
    "snapshotIndex": {"type": "object", "additionalProperties": false, "required": ["step", "action", "capture_id"], "properties": {"step": {"type": "integer", "minimum": 1}, "action": {"const": "snapshot_index"}, "capture_id": {"type": "string"}}}
  }
}
